{
  "name": "okx-eea-ai-agent-trading-app",
  "version": "1.1.0",
  "description": "Aplikacja React do handlu kryptowalutami z giełdą OKX Europe (eea.okx.com) oparta na okx/agent-trade-kit, okx/agent-skills oraz serwerze MCP",
  "main": "server/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server/index.js",
    "mcp": "node server/mcp-server.js --site eea --demo",
    "skills:add": "npx skills add okx/agent-skills"
  },
  "keywords": [
    "okx",
    "eea.okx.com",
    "react",
    "agent-trade-kit",
    "okx-trade-mcp",
    "agent-skills",
    "mcp",
    "crypto-trading",
    "usdc"
  ],
  "okxAgentConfig": {
    "site": "eea",
    "baseUrl": "https://eea.okx.com",
    "defaultMode": "demo",
    "defaultAiStatus": "deactivated",
    "quoteCurrency": "USDC",
    "mcpPackage": "@okx_ai/okx-trade-mcp",
    "skillsRepo": "okx/agent-skills",
    "tradeKitRepo": "https://github.com/okx/agent-trade-kit"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "localtunnel": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
